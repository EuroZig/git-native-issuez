.{
    .name = .git_native_issuez,
    .version = "0.6.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0x7bba8a1d2cbb8815,
    // What the release archives link is in THIRD_PARTY_LICENSES: keep it current.
    .dependencies = .{
        // TUI. A libvaxis main commit on Zig 0.17. Only fetched when
        // -Dtui=true (default).
        .vaxis = .{
            .url = "git+https://github.com/rockorager/libvaxis#74b7d916c8879e5379f428ea8c4d43d1a1bb061b",
            .hash = "vaxis-0.6.0-BWNV_J2zDQArkPcsc2nkktgxfg2r0u1AwwQP9WLugo_1",
            .lazy = true,
        },
        // Markdown descriptions and comments, rendered by `show` and the TUI.
        // A markdownz main commit on Zig 0.17; fetched for git-issue, not
        // for projects that only use the library.
        .markdownz = .{
            .url = "git+https://github.com/StaffinityAI/markdownz#49a0cefd6c23387cdbf0b2ee8b424ddcc1408ae3",
            .hash = "markdown-0.1.0-B0nUV6Q8AwBbBCNd7pWUPws9rQWHq9c9zSQohEQOyT8y",
            .lazy = true,
        },
        // Grapheme widths for markdown-term and libvaxis, one module for
        // both: the commit libvaxis pins.
        .uucode = .{
            .url = "git+https://github.com/jacobsandlund/uucode#1fb73433bba5d93366c57f23ff2e9d7939746500",
            .hash = "uucode-0.2.0-ZZjBPm6FVgBcY-79AHV8ckQj86z0JwOyVyj89VeZrEiv",
            .lazy = true,
        },
        // Where the TUI keeps the user's state file. A known-folders master
        // commit on Zig 0.17; only fetched with the TUI.
        .known_folders = .{
            .url = "git+https://github.com/ziglibs/known-folders#c7a8a1974ccf8b5b022ee7f4b13fd734cdd89ae1",
            .hash = "known_folders-0.0.0-Fy-PJiLLAABzqCdF6GWFmE36oCwioOh6Uxj4FF1Neanr",
            .lazy = true,
        },
        // MCP server (`git issue mcp`). A blitzmcp main commit on Zig 0.17;
        // only fetched when -Dmcp=true (default).
        .blitzmcp = .{
            .url = "git+https://github.com/StaffinityAI/blitzmcp#ae2847b4705d36bc3bae8aa72abb18b5e7ea53b8",
            .hash = "blitzmcp-0.1.0-R76_bcAyBACFcbZV_TC2pzVsxQ5R8_DcICuRpIALr8AB",
            .lazy = true,
        },
        // Live updates in the TUI and the MCP server: watches the refs.
        // A nightwatch master commit on Zig 0.17; only fetched when either is
        // built.
        .nightwatch = .{
            .url = "git+https://github.com/neurocyte/nightwatch#421667358e907be504918f339f3d09a42fc1c90a",
            .hash = "nightwatch-1.0.0-uXzeH1QSAwD990k0ddEUyOFNS1uD3bPqCyEMOr5DStgy",
            .lazy = true,
        },
        // Upstream git-native-issue (GPL-2.0), the interop test oracle.
        // Never vendored; only fetched by test-interop / test-upstream-suite.
        .git_native_issue = .{
            .url = "git+https://github.com/remenoscodes/git-native-issue#004c0f9f66152471595a82ad14d01735518ac6e6",
            .hash = "N-V-__8AANZ_FQDK_dKZMtrsZb7Q9uIi6QcIEtg1VljiuUGg",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
